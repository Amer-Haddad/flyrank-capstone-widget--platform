PORT=3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=flyrank-widget-platform
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flyrank_widget
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
GEO_PROVIDER_A_URL=https://ip-api.com/json/
GEO_PROVIDER_B_URL=https://ipapi.co/
GEO_ENRICHMENT_FAILURE_MODE=none
MAILER_MODE=smtp
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM=your-sender@gmail.com
TEST_EMAIL=your-recipient@example.com
NOTIFICATION_EMAIL=your-recipient@example.com
